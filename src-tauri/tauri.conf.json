{
  "productName": "qSpider",
  "version": "../package.json",
  "identifier": "org.qsp.qspider",
  "build": {
    "frontendDist": "../dist/apps/player-desktop",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "pnpm run serve:desktop",
    "beforeBuildCommand": "pnpm run build:desktop"
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "app", "dmg"],
    "publisher": "QSPFoundation",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": [],
    "externalBin": [],
    "copyright": "QSPFoundation",
    "category": "Entertainment",
    "shortDescription": "Player to run QSP games",
    "longDescription": "",
    "createUpdaterArtifacts": "v1Compatible",
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": ["English", "Russian", "Ukrainian", "SimpChinese", "TradChinese"],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "Russian": "./lang/Russian.nsh",
          "Ukrainian": "./lang/Ukrainian.nsh"
        }
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "freezePrototype": false
    },
    "windows": [
      {
        "title": "qSpider",
        "width": 1024,
        "height": 768,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "useHttpsScheme": true
      }
    ]
  },
  "plugins": {
    "cli": {
      "description": "qSpider CLI",
      "args": [
        {
          "name": "filePath",
          "index": 1,
          "takesValue": true,
          "description": "Game file to open"
        },
        {
          "short": "f",
          "name": "file",
          "takesValue": true,
          "description": "Game file to open"
        }
      ]
    },
    "updater": {
      "endpoints": ["https://qspfoundation.github.io/qspider/updater-v2.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1RjFFRUMxODU0MjE5NUYKUldSZkdVS0Z3ZTd4RlVJQkZhQURQb0VJTVJ0QnI2NVZNOTJMQm5qdzZYRjNYa1ppVmZ0SFpndHQK"
    }
  }
}
