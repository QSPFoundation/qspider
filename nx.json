{
  "generators": {
    "@nrwl/cypress": {
      "cypress-project": {
        "linter": "eslint"
      }
    },
    "@nrwl/next": {
      "application": {
        "linter": "eslint"
      }
    },
    "@nrwl/node": {
      "application": {
        "linter": "eslint"
      },
      "library": {
        "linter": "eslint"
      }
    },
    "@nrwl/nx-plugin": {
      "plugin": {
        "linter": "eslint"
      }
    },
    "@nrwl/nest": {
      "application": {
        "linter": "eslint"
      }
    },
    "@nrwl/express": {
      "application": {
        "linter": "eslint"
      },
      "library": {
        "linter": "eslint"
      }
    },
    "@nx/workspace": {
      "library": {
        "linter": "eslint"
      }
    },
    "@nx/web": {
      "application": {
        "linter": "eslint"
      }
    },
    "@nx/react": {
      "application": {
        "style": "css",
        "linter": "eslint",
        "bundler": "vite",
        "babel": true
      },
      "component": {
        "style": "css"
      },
      "library": {
        "style": "css",
        "linter": "eslint",
        "unitTestRunner": "none"
      }
    },
    "@nx/web:application": {
      "style": "css",
      "linter": "eslint",
      "unitTestRunner": "none",
      "e2eTestRunner": "none"
    }
  },
  "defaultProject": "player",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": [
      {
        "dependsOn": ["^build"],
        "inputs": ["production", "^production"],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/vite/plugin"
        },
        "defaultConfiguration": "production"
      }
    ],
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "preview": [
      {
        "filter": {
          "plugin": "@nx/vite/plugin"
        },
        "defaultConfiguration": "development",
        "configurations": {
          "development": {},
          "production": {}
        }
      }
    ],
    "serve": [
      {
        "filter": {
          "plugin": "@nx/vite/plugin"
        },
        "defaultConfiguration": "development"
      }
    ],
    "lint": [
      {
        "filter": {
          "plugin": "@nx/eslint/plugin"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/.eslintrc.json",
          "{workspaceRoot}/eslint.config.js",
          "{workspaceRoot}/tools/eslint-rules/**/*",
          {
            "externalDependencies": ["eslint"]
          }
        ]
      }
    ]
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.js",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": ["{workspaceRoot}/babel.config.json", "{workspaceRoot}/tsconfig.base.json"]
  },
  "useInferencePlugins": false,
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "devTargetName": "dev",
        "typecheckTargetName": "typecheck",
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static"
      },
      "include": ["apps/player/**/*", "apps/player-desktop/**/*", "apps/player-standalone/**/*"]
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/docs/**/*",
        "apps/player/**/*",
        "apps/player-desktop/**/*",
        "apps/player-e2e/**/*",
        "apps/player-standalone/**/*",
        "libs/browser/**/*",
        "libs/contracts/**/*",
        "libs/debugger/**/*",
        "libs/desktop/**/*",
        "libs/docusaurus/**/*",
        "libs/game-shelf/**/*",
        "libs/game-state/**/*",
        "libs/html-renderer/**/*",
        "libs/i18n/**/*",
        "libs/importers/**/*",
        "libs/renderer/**/*",
        "libs/tauri-storage/**/*",
        "libs/utils/**/*"
      ]
    }
  ],
  "affected": {
    "legacy": true
  }
}
