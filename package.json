{
  "name": "qspider",
  "version": "1.4.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "nx": "nx",
    "start": "nx serve player",
    "start:standalone": "nx serve player-standalone",
    "start:desktop": "tauri dev",
    "start:desktop-standlone": "tauri dev -c src-tauri/standalone.conf.json",
    "start:docs": "nx serve docs",
    "serve:standalone-desktop": "nx run player-standalone:serve:desktop",
    "serve:desktop": "nx serve player-desktop",
    "prebuild": "rimraf ./dist",
    "build": "nx build --prod",
    "build:standalone": "nx build player-standalone --prod",
    "build:standalone-desktop": "nx run player-standalone:build:desktop",
    "build:desktop": "nx build player-desktop --prod --emptyOutDir",
    "build:docs": "nx build docs --prod",
    "test": "nx run-many --all --target=test",
    "lint": "nx run-many --all --target=lint",
    "typecheck": "nx run-many -t typecheck",
    "affected": "nx affected",
    "format": "nx format:write",
    "format:write": "nx format:write --all",
    "format:check": "nx format:check --all",
    "update": "nx migrate latest",
    "dep-graph": "nx dep-graph",
    "help": "nx help",
    "release": "commit-and-tag-version",
    "release:dry-run": "commit-and-tag-version --dry-run",
    "workspace-generator": "nx workspace-generator",
    "prepare": "husky || true",
    "tauri": "tauri",
    "standalone:config": "node tools/standalone-config/cli.mjs",
    "write-docs-translations": "nx write-translations docs --locale=ru && nx write-translations docs --locale=uk",
    "check:rust": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "check": "pnpm format:check && nx run-many -t lint typecheck test build && pnpm check:rust && pnpm e2e:web && pnpm e2e:standalone-web",
    "e2e:web": "nx build player && playwright test -c apps/player-e2e/targets/web/playwright.config.ts",
    "e2e:desktop": "node apps/player-e2e/targets/desktop/check-prereqs.ts && nx run player-e2e:build-desktop-e2e && node apps/player-e2e/targets/desktop/run-desktop-e2e.mjs",
    "e2e:standalone-web": "nx run player-e2e:e2e-standalone-web",
    "e2e:standalone-desktop": "node apps/player-e2e/targets/desktop/check-prereqs.ts && nx run player-e2e:e2e-standalone-desktop",
    "smoke:desktop": "nx run-many -t smoke-desktop smoke-desktop-standalone -p player-e2e --output-style=static --parallel=1 --nxBail=false",
    "check:full": "pnpm check && pnpm e2e:desktop && pnpm e2e:standalone-desktop"
  },
  "private": true,
  "dependencies": {
    "7z-wasm": "^1.1.0",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@iarna/toml": "^2.2.5",
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@nx/devkit": "24.0.1",
    "@qsp/converters": "^1.0.1",
    "@qsp/wasm-engine": "^1.6.1",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@react-spring/web": "^10.1.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-cli": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xoid/react": "^1.0.1",
    "clsx": "^2.1.1",
    "color": "^5.0.3",
    "dexie": "^4.4.6",
    "history": "^5.3.0",
    "howler": "^2.2.4",
    "i18next": "^26.5.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-chained-backend": "^5.0.6",
    "i18next-fetch-backend": "^8.0.0",
    "iarna-toml-esm": "^3.0.5",
    "monaco-editor": "^0.55.1",
    "mousetrap": "^1.6.5",
    "prism-react-renderer": "^2.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.0",
    "react-responsive": "^10.0.1",
    "react-use": "^17.6.1",
    "uuid": "^14.0.3",
    "workbox-core": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "xoid": "^1.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.36.0",
    "@nx/eslint": "24.0.1",
    "@nx/eslint-plugin": "24.0.1",
    "@nx/js": "24.0.1",
    "@nx/plugin": "24.0.1",
    "@nx/react": "24.0.1",
    "@nx/vite": "24.0.1",
    "@nx/vitest": "24.0.1",
    "@nx/web": "24.0.1",
    "@nx/workspace": "24.0.1",
    "@playwright/test": "^1.64.1",
    "@serenity-js/assertions": "3.49.0",
    "@serenity-js/console-reporter": "3.49.0",
    "@serenity-js/core": "3.49.0",
    "@serenity-js/mocha": "3.49.0",
    "@serenity-js/playwright": "3.49.0",
    "@serenity-js/playwright-test": "3.49.0",
    "@serenity-js/web": "3.49.0",
    "@serenity-js/webdriverio": "3.49.0",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@swc/helpers": "0.5.23",
    "@tauri-apps/cli": "^2",
    "@types/color": "^4.2.1",
    "@types/howler": "^2.2.13",
    "@types/mousetrap": "^1.6.14",
    "@types/node": "^25.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-transition-group": "^4.4.11",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/ui": "5.0.5",
    "@wdio/cli": "^10.0.0",
    "@wdio/globals": "^10.0.0",
    "@wdio/local-runner": "^10.0.0",
    "@wdio/mocha-framework": "^10.0.0",
    "@wdio/spec-reporter": "^10.0.0",
    "autoprefixer": "^10.6.1",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expect-webdriverio": "^6.1.0",
    "fflate": "0.8.3",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "~30.1.3",
    "lint-staged": "^17.6.0",
    "mocha": "10.8.2",
    "nx": "24.0.1",
    "playwright": "^1.64.1",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vite-plugin-dts": "~5.1.2",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.5",
    "webdriverio": "^10.0.0"
  },
  "commit-and-tag-version": {
    "bumpFiles": [
      {
        "filename": "src-tauri/Cargo.toml",
        "updater": "tools/cargo-version-updater.cjs"
      },
      {
        "filename": "package.json",
        "type": "json"
      }
    ],
    "skip": {
      "commit": true,
      "tag": true
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --flag v10_config_lookup_from_file"
    ],
    "*.{js,mjs,json,md,css,yml}": "prettier --write"
  },
  "overrides": {
    "@nx/eslint-plugin": {
      "@typescript-eslint/parser": "^8.0.0"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
