    "@react-spring/web": "^10.1.2",
    "@tauri-apps/api": "^1.6.0",
    "@xoid/react": "^1.0.1",
    "clsx": "^2.1.1",
    "color": "^5.0.3",
    "dexie": "^4.4.6",
    "history": "^5.3.0",
    "howler": "^2.2.4",
    "i18next": "^26.5.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-chained-backend": "^5.0.6",
    "i18next-fetch-backend": "^8.0.0",
    "iarna-toml-esm": "^3.0.5",
    "monaco-editor": "^0.55.1",
    "mousetrap": "^1.6.5",
    "prism-react-renderer": "^2.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.0",
    "react-responsive": "^10.0.1",
    "react-use": "^17.6.1",
    "uuid": "^14.0.3",
    "workbox-core": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "xoid": "^1.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.36.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/plugin": "23.3.0",
    "@nx/react": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@swc/helpers": "0.5.23",
    "@tauri-apps/cli": "^1.6.2",
    "@types/color": "^4.2.1",
    "@types/howler": "^2.2.13",
    "@types/mousetrap": "^1.6.14",
    "@types/node": "^25.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-transition-group": "^4.4.11",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/ui": "5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "~30.1.3",
    "lint-staged": "^17.6.0",
    "nx": "23.3.0",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vite-plugin-dts": "~5.1.2",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-pwa": "^2.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.5"
  },
  "standard-version": {
    "bumpFiles": [
      {
        "filename": "src-tauri/Cargo.toml",
        "updater": "tools/cargo-version-updater.cjs"
      },
      {
        "filename": "package.json",
        "type": "json"
      }
    ],
    "skip": {
      "commit": true,
      "tag": true
    }
  },
  "lint-staged": {
    "*.ts": "eslint"
  },
  "overrides": {
    "@nx/eslint-plugin": {
      "@typescript-eslint/parser": "^8.0.0"
    }
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
