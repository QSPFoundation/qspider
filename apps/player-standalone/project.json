{
  "name": "player-standalone",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/player-standalone/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "inputs": [
        "production",
        "^production",
        { "env": "VITE_QSPIDER_E2E" },
        { "env": "QSPIDER_E2E_STANDALONE_PUBLIC_DIR" }
      ],
      "configurations": {
        "development": {
          "mode": "development"
        },
        "desktop": {
          "mode": "desktop"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "configurations": {
        "development": {
          "mode": "development"
        },
        "desktop": {
          "mode": "desktop"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsc -p tsconfig.app.json --noEmit", "tsc -p tsconfig.spec.json --noEmit"]
      }
    }
  }
}
