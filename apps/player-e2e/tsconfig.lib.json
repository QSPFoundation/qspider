{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "fixtures/**/*.ts",
    "scenarios/**/*.ts",
    "screenplay/**/*.ts",
    "targets/web/**/*.ts",
    "targets/standalone/**/*.ts",
    "targets/desktop/prereqs.ts",
    "targets/desktop/prereqs.spec.ts",
    "targets/desktop/private-session.ts",
    "targets/desktop/private-session.spec.ts",
    "targets/desktop/native-dialog.ts",
    "targets/desktop/native-dialog.spec.ts",
    "targets/desktop/shards.ts",
    "targets/desktop/shards.spec.ts",
    "targets/desktop/spec-times.ts",
    "targets/desktop/spec-times.spec.ts",
    "targets/desktop/restart-step.ts",
    "targets/desktop/restart-step.spec.ts",
    "targets/desktop/platform/**/*.ts",
    "*.config.mts"
  ]
}
