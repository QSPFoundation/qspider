{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "types": ["node"]
  },
  "include": [
    "fixtures/**/*.ts",
    "scenarios/**/*.ts",
    "screenplay/**/*.ts",
    "targets/web/**/*.ts",
    "targets/desktop/prereqs.ts",
    "targets/desktop/prereqs.spec.ts",
    "web/**/*.ts",
    "*.config.mts"
  ]
}
