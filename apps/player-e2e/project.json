{
  "name": "player-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/player-e2e/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.desktop.json --noEmit"
      }
    },
    "e2e-web": {
      "executor": "nx:run-commands",
      "dependsOn": ["player:build"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "playwright test -c apps/player-e2e/targets/web/playwright.config.ts"
      }
    },
    "stage-standalone": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node apps/player-e2e/targets/standalone/stage-public.ts"
      }
    },
    "build-standalone-web-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["stage-standalone"],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "nx run player-standalone:build:production --skip-nx-cache",
          "node apps/player-e2e/targets/standalone/check-build.ts"
        ],
        "env": {
          "QSPIDER_E2E_STANDALONE_PUBLIC_DIR": "dist/e2e/standalone-public"
        }
      }
    },
    "e2e-standalone-web": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-standalone-web-e2e"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "playwright test -c apps/player-e2e/targets/web/playwright.standalone.config.ts"
      }
    },
    "build-desktop-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm tauri build --debug --no-bundle",
        "env": {
          "VITE_QSPIDER_E2E": "true"
        }
      }
    },
    "e2e-desktop": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-desktop-e2e"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node apps/player-e2e/targets/desktop/run-desktop-e2e.mjs"
      }
    },
    "build-desktop-standalone-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["stage-standalone"],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node tools/standalone-config/cli.mjs apps/player-e2e/fixtures/standalone/qspider.desktop.json --out dist/e2e/tauri.standalone-e2e.json",
          "pnpm tauri build --debug --no-bundle -c dist/e2e/tauri.standalone-e2e.json",
          "node apps/player-e2e/targets/standalone/check-build.ts"
        ],
        "env": {
          "VITE_QSPIDER_E2E": "true",
          "QSPIDER_E2E_STANDALONE_PUBLIC_DIR": "dist/e2e/standalone-public",
          "NX_SKIP_NX_CACHE": "true",
          "CARGO_TARGET_DIR": "target/e2e-standalone"
        }
      }
    },
    "e2e-standalone-desktop": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-desktop-standalone-e2e"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node apps/player-e2e/targets/desktop/run-desktop-e2e.mjs --standalone"
      }
    }
  }
}
