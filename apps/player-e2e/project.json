{
  "name": "player-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/player-e2e/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.desktop.json --noEmit"
      }
    },
    "e2e-web": {
      "executor": "nx:run-commands",
      "dependsOn": ["player:build"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "playwright test -c apps/player-e2e/targets/web/playwright.config.ts"
      }
    },
    "build-desktop-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm tauri build --debug --no-bundle",
        "env": {
          "VITE_QSPIDER_E2E": "true"
        }
      }
    },
    "e2e-desktop": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-desktop-e2e"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "wdio run apps/player-e2e/targets/desktop/wdio.conf.ts"
      }
    }
  }
}
