{
  "name": "player-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/player-e2e/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.desktop.json --noEmit"
      }
    },
    "e2e-web": {
      "executor": "nx:run-commands",
      "dependsOn": ["player:build"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "playwright test -c apps/player-e2e/targets/web/playwright.config.ts"
      }
    },
    "stage-standalone": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node apps/player-e2e/targets/standalone/stage-public.ts"
      }
    },
    "build-standalone-web-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["stage-standalone"],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "nx run player-standalone:build:production --skip-nx-cache",
          "node apps/player-e2e/targets/standalone/check-build.ts"
        ],
        "env": {
          "QSPIDER_E2E_STANDALONE_PUBLIC_DIR": "dist/e2e/standalone-public"
        }
      }
    },
    "e2e-standalone-web": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-standalone-web-e2e"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "playwright test -c apps/player-e2e/targets/web/playwright.standalone.config.ts"
      }
    },
    "build-desktop-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node apps/player-e2e/targets/desktop/webdriver-config.mjs src-tauri/tauri.conf.json dist/e2e/tauri.webdriver.json",
          "pnpm tauri build --debug --no-bundle -c dist/e2e/tauri.webdriver.json"
        ],
        "env": {
          "VITE_QSPIDER_E2E": "true"
        }
      }
    },
    "e2e-desktop": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-desktop-e2e"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node apps/player-e2e/targets/desktop/run-desktop-e2e.mjs"
      }
    },
    "build-desktop-standalone-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["stage-standalone"],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node tools/standalone-config/cli.mjs apps/player-e2e/fixtures/standalone/qspider.desktop.json --out dist/e2e/tauri.standalone-e2e.json",
          "node apps/player-e2e/targets/desktop/webdriver-config.mjs dist/e2e/tauri.standalone-e2e.json dist/e2e/tauri.standalone-webdriver.json",
          "pnpm tauri build --debug --no-bundle -c dist/e2e/tauri.standalone-e2e.json -c dist/e2e/tauri.standalone-webdriver.json",
          "node apps/player-e2e/targets/standalone/check-build.ts"
        ],
        "env": {
          "VITE_QSPIDER_E2E": "true",
          "QSPIDER_E2E_STANDALONE_PUBLIC_DIR": "dist/e2e/standalone-public",
          "NX_SKIP_NX_CACHE": "true",
          "CARGO_TARGET_DIR": "target/e2e-standalone"
        }
      }
    },
    "e2e-standalone-desktop": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-desktop-standalone-e2e"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node apps/player-e2e/targets/desktop/run-desktop-e2e.mjs --standalone"
      }
    },
    "smoke-desktop": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build-desktop-e2e"],
      "metadata": {
        "description": "Launch smoke of the main desktop player. The game path and --expect-text come from fixtures/e2e-game.ts (E2E_GAME.path, E2E_GAME.text.start), the source of truth: keep them in step."
      },
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node apps/player-e2e/targets/smoke/run-smoke.mjs --app src-tauri/target/debug/qspider --file apps/player-e2e/fixtures/e2e-game/e2e-game.qsps --expect-text 'E2E START'"
      }
    },
    "smoke-desktop-standalone": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build-desktop-standalone-e2e"],
      "metadata": {
        "description": "Launch smoke of the desktop standalone player. --expect-text comes from fixtures/standalone-game.ts (STANDALONE_GAME.text.start), the source of truth: keep it in step."
      },
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node apps/player-e2e/targets/smoke/run-smoke.mjs --app src-tauri/target/e2e-standalone/debug/qspider --expect-text 'STANDALONE START'"
      }
    }
  }
}
