{
  "name": "player-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/player-e2e/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.lib.json --noEmit"
      }
    },
    "e2e-web": {
      "executor": "nx:run-commands",
      "dependsOn": ["player:build"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "playwright test -c apps/player-e2e/playwright.config.ts"
      }
    }
  }
}
