{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "allowImportingTsExtensions": true,
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework", "expect-webdriverio"]
  },
  "include": ["fixtures/**/*.ts", "scenarios/**/*.ts", "screenplay/**/*.ts", "targets/desktop/**/*.ts"],
  "exclude": ["targets/desktop/**/*.spec.ts"]
}
