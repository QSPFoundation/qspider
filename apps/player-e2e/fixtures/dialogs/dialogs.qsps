# start
*pl 'DIALOGS START'
act 'Show message':
  msg 'DIALOG MESSAGE'
  *clr & *pl 'AFTER MESSAGE'
end
act 'Ask input':
  $r = input('DIALOG PROMPT')
  *clr & *pl 'INPUT ECHO: <<$r>>'
end
act 'Open menu':
  $picked = ''
  $arr[0] = 'First item:menu_first:'
  $arr[1] = '-:-'
  $arr[2] = 'Second item:menu_second:'
  menu '$arr'
  if $picked = '': *clr & *pl 'MENU CANCELLED'
end
act 'Show view': view 'view.png'
act 'Hide view': view ''
act 'Wait short':
  wait 300
  *clr & *pl 'AFTER SHORT WAIT'
end
act 'Wait long':
  wait 3000
  *clr & *pl 'AFTER LONG WAIT'
end
---

# menu_first
$picked = 'first'
*clr & *pl 'MENU RESULT FIRST'
---

# menu_second
$picked = 'second'
*clr & *pl 'MENU RESULT SECOND'
---
