# start
*pl 'GAME HTML START'
act 'markup': gt 'markup'
act 'links': gt 'links'
act 'events': gt 'events'
act 'form': gt 'form'
act 'bind': gt 'bind'
act 'watchers': gt 'watchers'
act 'hostile': gt 'hostile'
---

# hostile
*clr
act 'hostile svg': gt 'hostile_svg'
act 'hostile iframe': gt 'hostile_iframe'
act 'hostile js': gt 'hostile_js'
act 'hostile tags': gt 'hostile_tags'
act 'hostile tag attr': gt 'hostile_tag_attr'
act 'hostile malformed': gt 'hostile_malformed'
act 'hostile form': gt 'hostile_form'
act 'hostile urls': gt 'hostile_urls'
---

# markup
*clr
*pl '<b data-qa="mk-bold">MARKUP BOLD</b>'
---

# links
*clr
act 'num target': *clr & *pl 'NUM LINK RESULT'
*pl '<a href="exec:gt ''exec_done''" data-qa="exec-link">EXEC LINK</a>'
*pl '<a href="1" data-qa="num-link">NUM LINK</a>'
*pl '<img src="view.png" width="40" height="40" usemap="#m" data-qa="area-image"><map name="m"><area shape="rect" coords="0,0,40,40" href="exec:gt ''area_done''" data-qa="area-link"></map>'
---

# exec_done
*clr & *pl 'EXEC LINK RESULT'
---

# area_done
*clr & *pl 'AREA LINK RESULT'
---

# events
*clr
*pl '<span qsp-on:click="exec:gt ''click_done''" data-qa="on-click">CLICK ME</span>'
*pl '<span qsp-on:mouseenter="exec:gs ''enter_done''" data-qa="on-enter">ENTER ME</span>'
*pl '<span qsp-on:mouseleave="exec:gs ''leave_done''" data-qa="on-leave">LEAVE ME</span>'
---

# click_done
*clr & *pl 'ON CLICK RESULT'
---

# enter_done
! Once, and via gs (gt would clear the main panel and detach the hovered element mid-hover): a re-render under the pointer re-fires the event.
if entered = 0:
  entered = 1
  *pl '<span data-qa="enter-result">ON ENTER RESULT</span>'
end
---

# leave_done
! Once, and via gs (gt would clear the main panel and detach the hovered element mid-hover): a re-render under the pointer re-fires the event.
if left = 0:
  left = 1
  *pl '<span data-qa="leave-result">ON LEAVE RESULT</span>'
end
---

# form
*clr
*pl '<form qsp-on:submit="exec:gt ''form_done''" data-qa="the-form"><input type="text" data-qa="form-field"><button type="submit" data-qa="form-submit">GO</button></form>'
---

# form_done
*clr & *pl 'FORM SUBMIT RESULT'
---

# bind
*clr
$boundstr = ''
*pl '<input type="text" qsp-bind="$boundstr" data-qa="bind-field">'
act 'show bind': *clr & *pl 'BOUND=<<$boundstr>>'
---

# watchers
*clr
$wvar = 'VAR ONE'
$wcss = ''
*pl '<qsp-variable name="$wvar"></qsp-variable>'
*pl '<qsp-show when="$wvar" equals="VAR TWO"><span data-qa="show-child">SHOWN</span></qsp-show>'
*pl '<qsp-style from="$wcss"></qsp-style>'
*pl '<qsp-region name="reg"></qsp-region>'
*pl '<qsp-layer name="lay" index="1">LAYER TEXT</qsp-layer>'
act 'change var': $wvar = 'VAR TWO'
act 'change style': $wcss = '.e2e{color:blue}'
act 'fill region':
  $qspider_region['reg'] = 'REGION TEXT'
  exec 'qspider.update_region:reg'
end
act 'fill layer':
  qspider_layers['lay'] = 1
  exec 'qspider.update_layer:lay'
end
---

# hostile_svg
*clr
*pl '<svg><script>document.querySelector(''[data-qsp="main-content"]'').append(''PWNED'')</script></svg>'
*pl 'SVG BENIGN'
---

# hostile_iframe
*clr
*pl '<iframe data-qa="hostile-frame" srcdoc="<script>parent.document.body.setAttribute(''data-qa-pwned'',''1'')</script>"></iframe>'
*pl 'IFRAME BENIGN'
---

# hostile_js
*clr
*pl '<a target="_self" href="JavaScript:document.querySelector(''[data-qsp=&quot;main-content&quot;]'').append(''PWNED'')" data-qa="js-link">JS LINK</a>'
*pl '<a target="_self" href=" java&#9;script:document.querySelector(''[data-qsp=&quot;main-content&quot;]'').append(''PWNED'')" data-qa="js-tab-link">JS TAB LINK</a>'
*pl 'JS BENIGN'
---

# hostile_form
*clr
! A form URL attribute runs code on submit. The button's formaction overrides the form's action.
*pl 'FORM RISKY'
*pl '<form action="javascript:document.body.setAttribute(''data-qa-pwned'',''1'')" data-qa="hostile-form-action"><button type="submit" data-qa="hostile-formaction" formaction="javascript:document.body.setAttribute(''data-qa-pwned'',''1'')">FORMACTION</button><input type="submit" value="INPUT" data-qa="hostile-input-formaction" formaction="&#1;java&#10;script:document.body.setAttribute(''data-qa-pwned'',''1'')"></form>'
! A dashed name is camelCased into the prop later (form-action becomes formAction), so the guard must see it too.
*pl '<form><button type="submit" data-qa="hostile-form-dash" form-action="javascript:document.body.setAttribute(''data-qa-pwned'',''1'')">DASH</button></form>'
*pl 'FORM BENIGN'
---

# hostile_urls
*clr
! URL attributes on images and SVG links, colon and dashed spellings (xlink-href becomes xlinkHref, then xlink:href).
*pl 'URLS RISKY'
*pl '<img data-qa="hostile-img-src" src="javascript:document.body.setAttribute(''data-qa-pwned'',''1'')">'
*pl '<svg><a data-qa="hostile-svg-link" xlink:href="javascript:document.body.setAttribute(''data-qa-pwned'',''1'')"><text y="10">x</text></a></svg>'
*pl '<svg><a data-qa="hostile-svg-data" xlink:href="data:text/html,x"><text y="10">x</text></a></svg>'
*pl '<svg><a data-qa="hostile-svg-dash" xlink-href="javascript:document.body.setAttribute(''data-qa-pwned'',''1'')"><text y="10">x</text></a></svg>'
*pl '<svg><a data-qa="hostile-svg-dash-data" xlink-href="data:text/html,x"><text y="10">x</text></a></svg>'
! A data: picture on the non-navigating svg image stays (Inkscape embeds pictures this way).
*pl '<svg><image data-qa="svg-data-image" xlink:href="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==" width="1" height="1"/></svg>'
*pl 'URLS BENIGN'
---

# hostile_malformed
*clr
*pl '<b><i>MALFORMED OK'
---

# hostile_tags
*clr
! Text first: the HTML parser moves base/meta that open the content into the discarded <head>.
*pl 'TAGS RISKY'
*pl '<base data-qa="hostile-base" href="https://example.invalid/">'
*pl '<meta data-qa="hostile-meta" http-equiv="refresh" content="600;url=about:blank">'
*pl '<embed data-qa="hostile-embed" src="x.svg">'
*pl '<object data-qa="hostile-object" data="x.svg"></object>'
*pl 'TAGS BENIGN'
---

# hostile_tag_attr
*clr
! A tag= attribute overrides the parsed tag: the overriding tag must face the same drop and sandbox rules.
! Text first, as in hostile_tags.
*pl 'TAG ATTR RISKY'
*pl '<b tag="IFRAME" data-qa="hostile-tag-frame" srcdoc="<script>parent.document.body.setAttribute(''data-qa-pwned'',''1'')</script>">x</b>'
*pl '<br tag="base" data-qa="hostile-tag-base" href="https://example.invalid/">'
*pl '<i tag="meta" data-qa="hostile-tag-meta" http-equiv="refresh" content="600;url=about:blank">m</i>'
*pl '<svg><g tag="svg:script">document.body.setAttribute(''data-qa-pwned'',''1'')</g></svg>'
*pl '<svg><svg:script>document.body.setAttribute(''data-qa-pwned'',''1'')</svg:script></svg>'
*pl 'TAG ATTR BENIGN'
---
